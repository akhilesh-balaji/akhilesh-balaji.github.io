---
import '../styles/styles.css';
import { banners, type BannerName } from '../banners.ts';

interface Props {
  banner: BannerName;
  title?: string;
}

const { banner, title = 'Akhilesh Balaji' } = Astro.props;
const current = banners[banner].src;

const googleFonts =
  "https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wdth,wght@0,62.5..100,100..900;1,62.5..100,100..900&family=Noto+Serif+Grantha&family=Noto+Serif+Tamil:ital,wght@0,100..900;1,100..900&family=Noto+Serif+Telugu:wght@100..900&display=swap";
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- This page's banner loads at high priority. -->
    <link rel="preload" as="image" href={current} fetchpriority="high" />

    <link rel="preload" as="image" href="/logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <!-- Non-render-blocking stylesheet (fonts use display=swap anyway) -->
    <link rel="stylesheet" href={googleFonts} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={googleFonts} /></noscript>

    <!-- Iosevka Aile -->
    <link rel="preload" href="/fonts/IosevkaAile/WOFF2/IosevkaAile-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/IosevkaAile/WOFF2/IosevkaAile-Italic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/IosevkaAile/WOFF2/IosevkaAile-Bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <canvas
      id="bouncing-balls"
      class="hidden sm:fixed sm:inset-0 sm:z-20 sm:block pointer-events-none"
    ></canvas>
    <slot />
    <script>
      import '../scripts/vim.js';
      import '../scripts/bouncing-balls.ts';
    </script>
  </body>
</html>
