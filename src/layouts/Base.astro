---
import '../styles/styles.css';

interface Props {
  banner: 'math' | 'art';
}

const banners = {
  math: '/math-drawing-banner-2.webp',
  art: '/classical_square.webp',
};
const { banner } = Astro.props;
const current = banners[banner];
const other = banner === 'art' ? banners.math : banners.art;

const googleFonts =
  'https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wdth,wght@0,62.5..100,100..900;1,62.5..100,100..900&family=Noto+Serif+Grantha&family=Noto+Serif+Tamil:ital,wght@0,100..900;1,100..900&display=swap';
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Akhilesh Balaji</title>

    <!-- This page's banner loads at high priority; the other banner is only
         prefetched (idle priority) so it is cached before the user navigates. -->
    <link rel="preload" as="image" href={current} fetchpriority="high" />
    <link rel="prefetch" as="image" href={other} />

    <link rel="preload" as="image" href="/logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <!-- Non-render-blocking stylesheet (fonts use display=swap anyway) -->
    <link rel="stylesheet" href={googleFonts} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={googleFonts} /></noscript>

    <!-- Iosevka Aile -->
    <link rel="preload" href="/fonts/IosevkaAile/WOFF2/IosevkaAile-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/IosevkaAile/WOFF2/IosevkaAile-Italic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/IosevkaAile/WOFF2/IosevkaAile-Bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <canvas
      id="bouncing-balls"
      class="hidden sm:fixed sm:inset-0 sm:z-20 sm:block pointer-events-none"
    ></canvas>
    <slot />
    <script>
      import '../scripts/vim.js';
      import '../scripts/bouncing-balls.ts';
    </script>
  </body>
</html>
